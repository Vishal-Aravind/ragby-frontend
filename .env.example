# Frontend environment variables. Copy to .env.local and fill in.
# Names only — never commit real values to this file.

# ── Supabase ──────────────────────────────────────────────
# The service role key bypasses RLS — server-side routes only,
# never expose it to the browser (note the missing NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=

# ── URLs ──────────────────────────────────────────────────
# BACKEND_BASE_URL and BACKEND_URL point at the same service —
# some routes (e.g. /api/events/*) read the second name.
# Keep both in sync.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
BACKEND_BASE_URL=
BACKEND_URL=
NEXT_PUBLIC_BACKEND_URL=

# ── Sentry ────────────────────────────────────────────────
# A DSN is safe to expose to the browser (it can only submit
# events, never read project data), which is why it is
# NEXT_PUBLIC. Must be set in Vercel too — without it the
# frontend Sentry setup is inert in production.
NEXT_PUBLIC_SENTRY_DSN=

# Deep link for the admin System Health tab's "Open Sentry"
# button. Needs the org SLUG, not the numeric id:
# https://<org-slug>.sentry.io/issues/?project=<project-id>
NEXT_PUBLIC_SENTRY_PROJECT_URL=
